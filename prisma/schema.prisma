datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String         @unique
  password     String
  createdAt    DateTime       @default(now())
  Files        File[]
  UserStats    UserStats[]
  UserActivity UserActivity[]
}

model UserStats {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  fileCount Int
  totalSize Int
  lastLogin DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserActivity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  activity  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?
}

enum ActivityType {
  LOGIN
  UPLOAD
  DOWNLOAD
  DELETE
}

model File {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  size        Int
  contentType String
  path        String
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
